# Create an EmailJS service and two templates, then copy these values to .env.local.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_REQUEST_TEMPLATE_ID=

# Configure the request template to send to the EduLearn team inbox. Include
# customer_name, customer_email, customer_phone, request_type, course, message,
# and reply_to in the email content so the team can follow up.
